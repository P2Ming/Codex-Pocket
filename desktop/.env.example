# NAS 的局域网或 VPN 地址，不要填写 HTTPS 域名
CODEX_POCKET_NAS_HOST=192.168.1.10
CODEX_POCKET_NAS_PORT=7000

# 必须与 NAS 的 nas/frps.toml 完全一致
CODEX_POCKET_FRP_TOKEN=replace-with-a-long-random-frp-token
CODEX_POCKET_REMOTE_PORT=7001

# 手机网页登录密码，至少 12 位，并且不要与 FRP Token 相同
CODEX_POCKET_PIN=replace-with-a-different-random-access-pin

# Pocket 本机监听端口和默认工作目录
CODEX_POCKET_PORT=3081
CODEX_POCKET_CWD=C:\path\to\your\workspace

# 可选：Codex CLI 不在 PATH 时填写完整路径
# CODEX_POCKET_CODEX=C:\path\to\codex.exe

# 可选：frpc 下载缓存和运行配置目录
# CODEX_POCKET_HOME=C:\path\to\private\codex-pocket-state
